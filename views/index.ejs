<% layout("/layouts/boilerplate.ejs") %>
    <%for(let note of notes){%>
        <div class="note">
            <h3>Author: <b><%= note.author%></b></h3>
            <p>Title: <b><%= note.title%></b></p>
            <div class="content">
                Content: <%=note.content%>
            </div>
            <!-- <p>Time: <%= note.created_at.toString().split(" ")[4]%></p>
            <p>Date: <%= note.created_at.toString().split(" ").slice(0.3).join("-")%></p> -->
            <div class="btn-container">
                <form method="get" action="/notes/<%=note._id%>"><button class="btn btn-success">Show</button></form>
                <form method="get" action="/notes/<%=note._id%>/edit"><button class="btn btn-primary">Edit</button></form>
                <form method="post" action="/notes/<%=note._id%>?_method=delete"><button class="btn btn-danger">Delete</button></form>
            </div>
        </div>
    <%}%>
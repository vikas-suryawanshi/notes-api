<% layout("/layouts/boilerplate.ejs") %>
    <%for(let note of notes){%>
        <div class="note">
            <h3>author:<%= note.author%></h3>
            <p>title:<b><%= note.title%></b></p>
            <div class="content">
                content:<%=note.content%>
            </div>
            <br/>
            <p>Time: <%= note.created_at.toString().split(" ")[4]%></p>
            <p>Date: <%= note.created_at.toString().split(" ").slice(0.3).join("-")%></p>
            <div class="button">

                <form method="get" action="/notes/<%=note._id%>/edit"><button>Edit</button></form>
                <form method="post" action="/notes/<%=note._id%>?_method=delete"><button>Delete</button></form>
                <form method="get" action="/notes/<%=note._id%>"><button>show</button></form>

            </div>
        </div>
        <br/>
        </hr>
    <%}%>
<% layout("/layouts/boilerplate.ejs") %>
    <div class="new">
        <h2>Create New Note</h2>
        <form method="post" action="/notes">
            <input placeholder="author name" name="author">
            <input placeholder="what`s your title ?" name="title">
            <textarea name="content" placeholder="put your content" ></textarea>
            <button class="btn btn-success">+ Add Note</button>
        </form>
    </div>
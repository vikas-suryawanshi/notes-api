<% layout("/layouts/boilerplate.ejs") %>
    <div class="new">
        <h2>Create New Note</h2>
        <form method="post" action="/notes" novalidate>
            <input placeholder="author name" name="author" required>
            <input placeholder="what`s your title ?" name="title" required>
            <textarea name="content" placeholder="put your content" required></textarea>
            <button class="btn btn-success">+ Add Note</button>
        </form>
    </div>
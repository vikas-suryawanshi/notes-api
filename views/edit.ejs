<% layout("/layouts/boilerplate.ejs") %>
    <div class="Edit">
        <p>Edit your info:<b><%= note.author%></b></p>
        <p>Title:<b><%= note.title%></b></p>
        <form method="post" action="/notes/<%=note._id%>?_method=put" novalidate >
            <textarea name="content" required><%=note.content%></textarea>
            <button type="submit">update</button>
        </form>
    </div>